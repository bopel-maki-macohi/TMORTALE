{
	"search.exclude": {
		"export/**/*.*": true
	},
	"haxe.importsSortOrder": "non-project -> project",
	"[haxe]": {
		"editor.codeActionsOnSave": {
			"source.sortImports": "always"
		}
	},
	"files.associations": {
		"*.hxp": "haxe"
	},
	"lime.targets": [
		{
			"name": "windows",
			"enabled": true,
			"label": "Windows"
		},
		{
			"name": "mac",
			"enabled": true,
			"label": "macOS"
		},
		{
			"name": "linux",
			"enabled": true,
			"label": "Linux"
		},
		{
			"name": "html5",
			"enabled": true,
			"label": "HTML5"
		},
		{
			"name": "android",
			"enabled": false,
			"label": "Android"
		},
		{
			"name": "ios",
			"enabled": false,
			"label": "iOS"
		},
		{
			"name": "hl",
			"enabled": true,
			"label": "HashLink"
		},
		{
			"name": "air",
			"enabled": false
		},
		{
			"name": "electron",
			"enabled": false
		},
		{
			"name": "flash",
			"enabled": false
		},
		{
			"name": "neko",
			"enabled": false
		},
		{
			"name": "tvos",
			"enabled": false
		}
	],
	"lime.defaultTargetConfiguration": "Windows / Debug",
	"lime.projectFile": "project.hxp",
}